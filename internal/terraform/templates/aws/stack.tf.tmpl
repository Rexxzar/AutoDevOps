terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "{{ .Region }}"
}
{{- if .ExistingVPCID }}

data "aws_vpc" "main" {
  id = "{{ .ExistingVPCID }}"
}
{{- else }}

resource "aws_vpc" "main" {
  cidr_block           = "{{ .VPCCIDR }}"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = {
    Name = "{{ .Name }}"
  }
}
{{- end }}

locals {
  vpc_id         = {{ if .ExistingVPCID }}data.aws_vpc.main.id{{ else }}aws_vpc.main.id{{ end }}
  vpc_cidr_block = {{ if .ExistingVPCID }}data.aws_vpc.main.cidr_block{{ else }}aws_vpc.main.cidr_block{{ end }}
}

output "vpc_id" {
  value = local.vpc_id
}
{{- if and (not .ExistingVPCID) (or .EC2 .ECS .RDS) }}

resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "{{ .Name }}"
  }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = {
    Name = "{{ .Name }}-public"
  }
}
{{- end }}
{{- if .EC2 }}

data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    # "al2023-ami-*-x86_64" also matches the "minimal" and "ecs-hvm" AL2023
    # variants, which omit the EC2 Instance Connect agent the Resource
    # Console relies on. Pin to the standard image: al2023-ami-2023.<ver>-kernel-<k>-x86_64.
    name   = "name"
    values = ["al2023-ami-2023.*-kernel-*-x86_64"]
  }
}

resource "aws_subnet" "ec2" {
  vpc_id                  = local.vpc_id
  cidr_block              = "{{ .EC2.SubnetCIDR }}"
  availability_zone       = "{{ .EC2.AvailabilityZone }}"
  map_public_ip_on_launch = true

  tags = {
    Name = "{{ .Name }}-ec2"
  }
}

resource "aws_security_group" "ec2" {
  name        = "{{ .Name }}-ec2"
  description = "Allow SSH inbound and all outbound for {{ .Name }}"
  vpc_id      = local.vpc_id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "AutoDevOps app containers"
    from_port   = 8100
    to_port     = 8999
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ .Name }}-ec2"
  }
}
{{- if not .ExistingVPCID }}

resource "aws_route_table_association" "ec2" {
  subnet_id      = aws_subnet.ec2.id
  route_table_id = aws_route_table.public.id
}
{{- end }}

resource "aws_instance" "main" {
  ami                    = data.aws_ami.amazon_linux.id
  instance_type          = "{{ .EC2.InstanceType }}"
  subnet_id              = aws_subnet.ec2.id
  vpc_security_group_ids = [aws_security_group.ec2.id]

  # Installs Docker so the SSH deployer (internal/deploy cloud_vm target) can
  # "docker load"/"docker run" Paketo-built images without a separate
  # provisioning step. docker + nginx are installed first and on their own:
  # certbot is NOT in the AL2023 default repos, and "dnf install" is atomic, so
  # bundling it would fail the whole line and leave Docker uninstalled. certbot
  # is installed best-effort here (ProvisionVMDirect also installs it on demand
  # via a dnf/pip fallback if this misses).
  user_data = <<-EOF
    #!/bin/bash
    dnf install -y docker nginx
    systemctl enable --now docker nginx
    usermod -aG docker ec2-user
    dnf install -y certbot python3-certbot-nginx || pip3 install certbot certbot-nginx || true
  EOF

  tags = {
    Name = "{{ .Name }}"
  }
}

output "ec2_instance_id" {
  value = aws_instance.main.id
}

output "ec2_public_ip" {
  value = aws_instance.main.public_ip
}

output "ec2_private_ip" {
  value = aws_instance.main.private_ip
}
{{- end }}
{{- if .RDS }}
{{ range $i, $s := .RDS.Subnets }}
resource "aws_subnet" "rds_{{ $i }}" {
  vpc_id                  = local.vpc_id
  cidr_block              = "{{ $s.CIDR }}"
  availability_zone       = "{{ $s.AvailabilityZone }}"
  map_public_ip_on_launch = true

  tags = {
    Name = "{{ $.Name }}-rds-{{ $i }}"
  }
}
{{ end }}
{{- if not .ExistingVPCID }}
{{ range $i, $s := .RDS.Subnets }}
resource "aws_route_table_association" "rds_{{ $i }}" {
  subnet_id      = aws_subnet.rds_{{ $i }}.id
  route_table_id = aws_route_table.public.id
}
{{ end }}
{{- end }}
resource "aws_db_subnet_group" "rds" {
  name       = "{{ .Name }}-rds"
  subnet_ids = [{{ range $i, $s := .RDS.Subnets }}aws_subnet.rds_{{ $i }}.id, {{ end }}]

  tags = {
    Name = "{{ .Name }}-rds"
  }
}

resource "aws_security_group" "rds" {
  name        = "{{ .Name }}-rds"
  description = "Allow database access from within the VPC for {{ .Name }}"
  vpc_id      = local.vpc_id

  # Open on the DB port so workloads in other VPCs (a separate ECS service or
  # EC2 VM provisioned as its own resource/stack) can reach this database — the
  # AWS-managed master password (Secrets Manager) is the security boundary,
  # mirroring the Azure Postgres "public access + AllowAzureServices" posture.
  ingress {
    description = "Database"
    from_port   = {{ .RDS.Port }}
    to_port     = {{ .RDS.Port }}
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ .Name }}-rds"
  }
}

resource "aws_db_instance" "main" {
  identifier                  = "{{ .Name }}-db"
  engine                      = "{{ .RDS.Engine }}"
  engine_version              = "{{ .RDS.EngineVersion }}"
  instance_class              = "{{ .RDS.InstanceClass }}"
  allocated_storage           = {{ .RDS.AllocatedStorage }}
  username                    = "{{ .RDS.Username }}"
  manage_master_user_password = true
  port                        = {{ .RDS.Port }}
  db_subnet_group_name        = aws_db_subnet_group.rds.name
  vpc_security_group_ids      = [aws_security_group.rds.id]
  publicly_accessible         = true
  skip_final_snapshot         = true

  tags = {
    Name = "{{ .Name }}-db"
  }
}

output "rds_endpoint" {
  value = aws_db_instance.main.address
}

output "rds_port" {
  value = aws_db_instance.main.port
}

output "rds_username" {
  value = aws_db_instance.main.username
}

output "rds_engine" {
  value = aws_db_instance.main.engine
}

output "rds_master_user_secret_arn" {
  value = aws_db_instance.main.master_user_secret[0].secret_arn
}

output "rds_security_group_id" {
  value = aws_security_group.rds.id
}
{{- end }}
{{- if .ECS }}
{{ range $i, $s := .ECS.Subnets }}
resource "aws_subnet" "ecs_{{ $i }}" {
  vpc_id                  = local.vpc_id
  cidr_block              = "{{ $s.CIDR }}"
  availability_zone       = "{{ $s.AvailabilityZone }}"
  map_public_ip_on_launch = true

  tags = {
    Name = "{{ $.Name }}-ecs-{{ $i }}"
  }
}
{{ end }}
{{ range $i, $s := .ECS.Subnets }}
resource "aws_route_table_association" "ecs_{{ $i }}" {
  subnet_id      = aws_subnet.ecs_{{ $i }}.id
  route_table_id = aws_route_table.public.id
}
{{ end }}
resource "aws_security_group" "alb" {
  name        = "{{ .Name }}-alb"
  description = "Allow inbound HTTP to the {{ .Name }} load balancer"
  vpc_id      = local.vpc_id

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ .Name }}-alb"
  }
}

resource "aws_security_group" "ecs_task" {
  name        = "{{ .Name }}-ecs-task"
  description = "Allow inbound traffic from the load balancer to {{ .Name }} tasks"
  vpc_id      = local.vpc_id

  ingress {
    description     = "From ALB"
    from_port       = {{ .ECS.ContainerPort }}
    to_port         = {{ .ECS.ContainerPort }}
    protocol        = "tcp"
    security_groups = [aws_security_group.alb.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "{{ .Name }}-ecs-task"
  }
}

resource "aws_lb" "main" {
  name               = "{{ .Name }}-alb"
  load_balancer_type = "application"
  internal           = false
  security_groups    = [aws_security_group.alb.id]
  subnets            = [{{ range $i, $s := .ECS.Subnets }}aws_subnet.ecs_{{ $i }}.id, {{ end }}]

  tags = {
    Name = "{{ .Name }}-alb"
  }
}

resource "aws_lb_target_group" "main" {
  name        = "{{ .Name }}-tg"
  port        = {{ .ECS.ContainerPort }}
  protocol    = "HTTP"
  vpc_id      = local.vpc_id
  target_type = "ip"

  # Accept any non-5xx response (including 404) as healthy — this is a liveness
  # check ("is the container serving HTTP"), not a correctness check. Backend
  # apps often only serve "/api/*" and return 404 on "/", which fails both the
  # default 200-only matcher AND a 200-399 matcher, leaving the ALB at 503. The
  # tightened interval + threshold bring a new task into service in ~30s
  # (2 x 15s) instead of the ~150s default (5 x 30s).
  health_check {
    path                = "/"
    matcher             = "200-499"
    interval            = 15
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 3
  }

  tags = {
    Name = "{{ .Name }}-tg"
  }
}

resource "aws_lb_listener" "main" {
  load_balancer_arn = aws_lb.main.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.main.arn
  }
}

resource "aws_ecs_cluster" "main" {
  name = "{{ .Name }}"

  tags = {
    Name = "{{ .Name }}"
  }
}

resource "aws_cloudwatch_log_group" "ecs" {
  name              = "/ecs/{{ .Name }}"
  retention_in_days = 7
}

resource "aws_iam_role" "ecs_execution" {
  name = "{{ .Name }}-ecs-execution"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action    = "sts:AssumeRole"
        Effect    = "Allow"
        Principal = { Service = "ecs-tasks.amazonaws.com" }
      }
    ]
  })

  tags = {
    Name = "{{ .Name }}-ecs-execution"
  }
}

resource "aws_iam_role_policy_attachment" "ecs_execution" {
  role       = aws_iam_role.ecs_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_iam_role" "ecs_task" {
  name = "{{ .Name }}-ecs-task"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action    = "sts:AssumeRole"
        Effect    = "Allow"
        Principal = { Service = "ecs-tasks.amazonaws.com" }
      }
    ]
  })

  tags = {
    Name = "{{ .Name }}-ecs-task"
  }
}

resource "aws_iam_role_policy" "ecs_task_exec" {
  name = "{{ .Name }}-ecs-exec"
  role = aws_iam_role.ecs_task.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = [
          "ssmmessages:CreateControlChannel",
          "ssmmessages:CreateDataChannel",
          "ssmmessages:OpenControlChannel",
          "ssmmessages:OpenDataChannel",
          "ssm:StartSession",
          "ecs:ExecuteCommand"
        ]
        Resource = "*"
      }
    ]
  })
}

resource "aws_ecs_task_definition" "main" {
  family                   = "{{ .Name }}"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                      = "{{ .ECS.CPU }}"
  memory                   = "{{ .ECS.Memory }}"
  execution_role_arn       = aws_iam_role.ecs_execution.arn
  task_role_arn            = aws_iam_role.ecs_task.arn

  container_definitions = jsonencode([
    {
      name      = "{{ .Name }}"
      image     = "{{ .ECS.ContainerImage }}"
      essential = true
      portMappings = [
        {
          containerPort = {{ .ECS.ContainerPort }}
          protocol      = "tcp"
        }
      ]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.ecs.name
          "awslogs-region"        = "{{ .Region }}"
          "awslogs-stream-prefix" = "ecs"
        }
      }
    }
  ])

  tags = {
    Name = "{{ .Name }}"
  }
}

resource "aws_ecs_service" "main" {
  name                   = "{{ .Name }}"
  cluster                = aws_ecs_cluster.main.id
  task_definition        = aws_ecs_task_definition.main.arn
  desired_count          = {{ .ECS.DesiredCount }}
  launch_type            = "FARGATE"
  enable_execute_command = true

  network_configuration {
    subnets          = [{{ range $i, $s := .ECS.Subnets }}aws_subnet.ecs_{{ $i }}.id, {{ end }}]
    security_groups  = [aws_security_group.ecs_task.id]
    assign_public_ip = true
  }

  load_balancer {
    target_group_arn = aws_lb_target_group.main.arn
    container_name   = "{{ .Name }}"
    container_port   = {{ .ECS.ContainerPort }}
  }

  depends_on = [aws_lb_listener.main]

  tags = {
    Name = "{{ .Name }}"
  }
}

output "ecs_alb_dns_name" {
  value = aws_lb.main.dns_name
}

output "ecs_cluster_name" {
  value = aws_ecs_cluster.main.name
}
{{- end }}
{{- if .ECR }}

resource "aws_ecr_repository" "main" {
  name                 = lower("{{ .Name }}")
  image_tag_mutability = "MUTABLE"

  image_scanning_configuration {
    scan_on_push = true
  }

  tags = {
    Name = "{{ .Name }}"
  }
}

output "ecr_repository_url" {
  value = aws_ecr_repository.main.repository_url
}
{{- end }}
