terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
{{- if .DB }}
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
{{- end }}
  }
}

provider "azurerm" {
  features {}
}

resource "azurerm_resource_group" "main" {
  name     = "{{ .Name }}-rg"
  location = "{{ .Location }}"

  tags = {
    Name = "{{ .Name }}"
  }
}

output "resource_group_name" {
  value = azurerm_resource_group.main.name
}

{{- if .ExistingVNet }}

data "azurerm_virtual_network" "main" {
  name                = "{{ .ExistingVNet.Name }}"
  resource_group_name = "{{ .ExistingVNet.ResourceGroup }}"
}
{{- else }}

resource "azurerm_virtual_network" "main" {
  name                = "{{ .Name }}-vnet"
  address_space       = ["{{ .VNetCIDR }}"]
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  tags = {
    Name = "{{ .Name }}"
  }
}
{{- end }}

locals {
  vnet_name           = {{ if .ExistingVNet }}data.azurerm_virtual_network.main.name{{ else }}azurerm_virtual_network.main.name{{ end }}
  vnet_resource_group = {{ if .ExistingVNet }}data.azurerm_virtual_network.main.resource_group_name{{ else }}azurerm_resource_group.main.name{{ end }}
}
{{- if .VM }}

resource "azurerm_subnet" "vm" {
  name                 = "{{ .Name }}-vm"
  resource_group_name  = local.vnet_resource_group
  virtual_network_name = local.vnet_name
  address_prefixes     = ["{{ .VM.SubnetCIDR }}"]
}

resource "azurerm_network_security_group" "vm" {
  name                = "{{ .Name }}-vm"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  security_rule {
    name                       = "SSH"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }

  security_rule {
    # internal/deploy's cloud_vm SSH deployer publishes app containers on a
    # deterministic port in this range (FNV-32a hash of the container name,
    # see internal/docker.hostPort).
    name                       = "AutoDevOpsAppContainers"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "8100-8999"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }

  tags = {
    Name = "{{ .Name }}-vm"
  }
}

resource "azurerm_subnet_network_security_group_association" "vm" {
  subnet_id                 = azurerm_subnet.vm.id
  network_security_group_id = azurerm_network_security_group.vm.id
}

resource "azurerm_public_ip" "vm" {
  name                = "{{ .Name }}-vm"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  allocation_method   = "Static"
  sku                 = "Standard"

  tags = {
    Name = "{{ .Name }}-vm"
  }
}

resource "azurerm_network_interface" "vm" {
  name                = "{{ .Name }}-vm"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.vm.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.vm.id
  }

  tags = {
    Name = "{{ .Name }}-vm"
  }
}

resource "azurerm_linux_virtual_machine" "main" {
  name                  = "{{ .Name }}"
  location              = azurerm_resource_group.main.location
  resource_group_name   = azurerm_resource_group.main.name
  size                  = "{{ .VM.Size }}"
  admin_username        = "{{ .VM.AdminUsername }}"
  network_interface_ids = [azurerm_network_interface.vm.id]

  disable_password_authentication = true

  admin_ssh_key {
    username   = "{{ .VM.AdminUsername }}"
    public_key = "{{ .VM.SSHPublicKey }}"
  }

  # Installs Docker so the SSH deployer (internal/deploy cloud_vm target) can
  # "docker load"/"docker run" Paketo-built images without a separate
  # provisioning step.
  custom_data = base64encode(<<-EOF
    #!/bin/bash
    apt-get update
    apt-get install -y docker.io
    systemctl enable --now docker
    usermod -aG docker {{ .VM.AdminUsername }}
  EOF
  )

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-jammy"
    sku       = "22_04-lts-gen2"
    version   = "latest"
  }

  tags = {
    Name = "{{ .Name }}"
  }
}

output "vm_public_ip" {
  value = azurerm_public_ip.vm.ip_address
}

output "vm_private_ip" {
  value = azurerm_network_interface.vm.private_ip_address
}

output "vm_admin_username" {
  value = azurerm_linux_virtual_machine.main.admin_username
}
{{- end }}
{{- if .DB }}

data "azurerm_client_config" "current" {}

resource "random_password" "db" {
  length  = 32
  special = true
}

resource "azurerm_postgresql_flexible_server" "main" {
  name                = "{{ .Name }}-db"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  version             = "{{ .DB.Version }}"
  sku_name            = "{{ .DB.SKU }}"
  storage_mb          = {{ .DB.StorageMB }}

  administrator_login    = "autodevopsadmin"
  administrator_password = random_password.db.result

  public_network_access_enabled = true

  authentication {
    active_directory_auth_enabled = true
    password_auth_enabled         = true
    tenant_id                     = data.azurerm_client_config.current.tenant_id
  }

  tags = {
    Name = "{{ .Name }}-db"
  }
}

resource "azurerm_postgresql_flexible_server_active_directory_administrator" "main" {
  server_name         = azurerm_postgresql_flexible_server.main.name
  resource_group_name = azurerm_resource_group.main.name
  tenant_id           = data.azurerm_client_config.current.tenant_id
  object_id           = "{{ .DB.AADAdminObjectID }}"
  principal_name      = "{{ .DB.AADAdminPrincipalName }}"
  principal_type      = "{{ .DB.AADAdminPrincipalType }}"
}

resource "azurerm_postgresql_flexible_server_firewall_rule" "azure_services" {
  name             = "AllowAzureServices"
  server_id        = azurerm_postgresql_flexible_server.main.id
  start_ip_address = "0.0.0.0"
  end_ip_address   = "0.0.0.0"
}

output "db_fqdn" {
  value = azurerm_postgresql_flexible_server.main.fqdn
}

output "db_admin_username" {
  value = azurerm_postgresql_flexible_server.main.administrator_login
}

output "db_admin_password" {
  value     = random_password.db.result
  sensitive = true
}
{{- end }}
{{- if .ACI }}

resource "azurerm_container_group" "main" {
  name                = "{{ .Name }}-aci"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  os_type             = "Linux"
  ip_address_type     = "Public"
  dns_name_label      = "{{ .Name }}"

  container {
    name   = "{{ .Name }}"
    image  = "{{ .ACI.ContainerImage }}"
    cpu    = {{ .ACI.CPU }}
    memory = {{ .ACI.MemoryGB }}

    ports {
      port     = {{ .ACI.ContainerPort }}
      protocol = "TCP"
    }
  }

  tags = {
    Name = "{{ .Name }}"
  }
}

output "aci_ip_address" {
  value = azurerm_container_group.main.ip_address
}

output "aci_fqdn" {
  value = azurerm_container_group.main.fqdn
}

output "aci_port" {
  value = {{ .ACI.ContainerPort }}
}
{{- end }}
{{- if .ACR }}

resource "azurerm_container_registry" "main" {
  name                = "{{ .ACR.Name }}"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  sku                 = "Basic"
  admin_enabled       = true

  tags = {
    Name = "{{ .Name }}"
  }
}

output "acr_login_server" {
  value = azurerm_container_registry.main.login_server
}

output "acr_admin_username" {
  value = azurerm_container_registry.main.admin_username
}
{{- end }}
